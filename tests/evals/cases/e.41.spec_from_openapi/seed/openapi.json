{
  "openapi": "3.0.0",
  "info": { "title": "MOCK_API", "version": "1.0.0" },
  "servers": [{ "url": "{secrets.base_url}" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token"
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/users": {
      "get": {
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "type": "object", "properties": { "id": { "type": "integer" } } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
